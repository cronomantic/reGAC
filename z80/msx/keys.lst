180+  8723              ; Read a line into input_buffer, as this adventure's codes.  The length comes
181+  8723              ; back in BC.  What is typed is shown as it goes.
182+  8723              ; Corrupts: everything
183+  8723              read_line:
184+  8723 21 E7 87                     ld      hl, input_buffer
185+  8726 22 E4 87                     ld      (line_ptr), hl
186+  8729 AF                           xor     a
187+  872A 32 E6 87                     ld      (line_length), a
188+  872D              .next_key:
189+  872D CD F6 86                     call    read_key
190+  8730 FE 0D                        cp      KEY_ENTER
191+  8732 28 2C                        jr      z, .finished
192+  8734 FE 08                        cp      KEY_DELETE
193+  8736 28 12                        jr      z, .rub_out
194+  8738 FE 20                        cp      32
195+  873A 38 F1                        jr      c, .next_key            ; nothing else is worth having
196+  873C 47                           ld      b, a
197+  873D 3A E6 87                     ld      a, (line_length)
198+  8740 FE 40                        cp      INPUT_MAX
199+  8742 30 E9                        jr      nc, .next_key           ; the line is full
200+  8744 78                           ld      a, b
201+  8745 CD 6D 87                     call    store_key
202+  8748 18 E3                        jr      .next_key
203+  874A              .rub_out:
204+  874A 3A E6 87                     ld      a, (line_length)
205+  874D B7                           or      a
206+  874E 28 DD                        jr      z, .next_key
207+  8750 3D                           dec     a
208+  8751 32 E6 87                     ld      (line_length), a
209+  8754 2A E4 87                     ld      hl, (line_ptr)
210+  8757 2B                           dec     hl
211+  8758 22 E4 87                     ld      (line_ptr), hl
212+  875B CD 08 85                     call    backspace
213+  875E 18 CD                        jr      .next_key
214+  8760              .finished:
215+  8760 CD B3 84                     call    new_line
216+  8763 3A E6 87                     ld      a, (line_length)
217+  8766 4F                           ld      c, a
218+  8767 06 00                        ld      b, 0
219+  8769 21 E7 87                     ld      hl, input_buffer
220+  876C C9                           ret
