  1+  8689              ; MIT License, Copyright (c) 2025 Cronomantic
  2+  8689              ;
  3+  8689              ; Reading the keyboard on an MSX1, which hangs off the same 8255 the Amstrad's
  4+  8689              ; does: the row wanted goes in the low four bits of port C and its eight keys
  5+  8689              ; come back on port B, with a bit low while its key is held.
  6+  8689              ;
  7+  8689              ; The BIOS has a routine for this and keeps the whole matrix in memory for
  8+  8689              ; anyone to read, at $FBE5 -- which is where the eleven rows below were
  9+  8689              ; measured, one key at a time.  None of that is any use once the interpreter
 10+  8689              ; takes the machine for itself: the BIOS is paged out and its interrupt is not
 11+  8689              ; running, so nothing is scanning any more.  So this scans.
 12+  8689              ;
 13+  8689              ; The top four bits of port C are the cassette motor, the tape output, the key
 14+  8689              ; click and the caps lamp, and none of them are ours to change; whatever the
 15+  8689              ; machine had in them when we arrived is what it keeps.
 16+  8689
 17+  8689              PPI_B           equ $A9                 ; the eight keys of the row chosen
 18+  8689              PPI_C           equ $AA                 ; and, in its low half, which row
 19+  8689
 20+  8689              KEY_ROWS        equ 11
 21+  8689              SHIFT_ROW       equ 6                   ; and the bit of it the shift is on
 22+  8689              SHIFT_BIT       equ %00000001
 23+  8689
 24+  8689              KEY_ENTER       equ 13
 25+  8689              KEY_DELETE      equ 8
 26+  8689              INPUT_MAX       equ 64                  ; as much of a line as is kept
 27+  8689
 28+  8689              ; A fiftieth of a second is about seventy thousand clock cycles here, and one
 29+  8689              ; look at the whole keyboard is about two thousand five hundred, so this many
 30+  8689              ; looks fill a frame.  Nothing turns on it being exact.
 31+  8689              LOOKS_A_FRAME   equ 28
 32+  8689
 33+  8689              ; Take note of what the machine has in the top half of port C, which is not
 34+  8689              ; ours to change.
 35+  8689              ; Corrupts: AF
 36+  8689              keyboard_init:
 37+  8689 DB AA                        in      a, (PPI_C)
 38+  868B E6 F0                        and     %11110000
 39+  868D 32 9E 86                     ld      (ppi_top), a
 40+  8690 C9                           ret
 41+  8691
 42+  8691              ; Read the eight keys of row A, into A.  A bit high means held.
 43+  8691              ; Corrupts: AF, C
 44+  8691              read_row:
 45+  8691 E6 0F                        and     %00001111
 46+  8693 4F                           ld      c, a
 47+  8694 3A 9E 86                     ld      a, (ppi_top)
 48+  8697 B1                           or      c
 49+  8698 D3 AA                        out     (PPI_C), a
 50+  869A DB A9                        in      a, (PPI_B)
 51+  869C 2F                           cpl                             ; now one means held
 52+  869D C9                           ret
 53+  869E
 54+  869E 00           ppi_top:        db      0
 55+  869F
 56+  869F              ; Look once at the whole keyboard.  The character comes back in A, and zero
 57+  869F              ; with the zero flag set when nothing useful is held.
 58+  869F              ;
 59+  869F              ; The shifts are passed over rather than reported, or holding one would look
 60+  869F              ; like nothing being typed at all; what they do is decided afterwards.
 61+  869F              ; Corrupts: BC, DE, HL
 62+  869F              scan_keyboard:
 63+  869F AF                           xor     a
 64+  86A0 32 E3 87                     ld      (key_found), a
 65+  86A3 21 82 87                     ld      hl, key_table
 66+  86A6 16 00                        ld      d, 0                    ; which row
 67+  86A8              .row:
 68+  86A8 D5                           push    de
 69+  86A9 7A                           ld      a, d
 70+  86AA CD 91 86                     call    read_row
 71+  86AD D1                           pop     de
 72+  86AE 1E 08                        ld      e, 8
 73+  86B0              .key:
 74+  86B0 1F                           rra
 75+  86B1 30 09                        jr      nc, .next_key
 76+  86B3 F5                           push    af
 77+  86B4 7E                           ld      a, (hl)
 78+  86B5 B7                           or      a
 79+  86B6 28 03                        jr      z, .a_shift             ; a shift on its own says nothing
 80+  86B8 32 E3 87                     ld      (key_found), a
 81+  86BB              .a_shift:
 82+  86BB F1                           pop     af
 83+  86BC              .next_key:
 84+  86BC 23                           inc     hl
 85+  86BD 1D                           dec     e
 86+  86BE 20 F0                        jr      nz, .key
 87+  86C0 14                           inc     d
 88+  86C1 7A                           ld      a, d
 89+  86C2 FE 0B                        cp      KEY_ROWS
 90+  86C4 20 E2                        jr      nz, .row
 91+  86C6 3A E3 87                     ld      a, (key_found)
 92+  86C9 B7                           or      a
 93+  86CA C8                           ret     z
 94+  86CB CD DC 86                     call    shift_held
 95+  86CE 3A E3 87                     ld      a, (key_found)
 96+  86D1 C8                           ret     z                       ; plain, as it is printed
 97+  86D2 CD E4 86                     call    to_shifted
 98+  86D5 B7                           or      a
 99+  86D6 C0                           ret     nz
100+  86D7 3A E3 87                     ld      a, (key_found)          ; shift says nothing about it
101+  86DA B7                           or      a
102+  86DB C9                           ret
103+  86DC
104+  86DC              ; Whether the shift is held; zero flag clear if it is.
105+  86DC              ; Corrupts: AF, C
106+  86DC              shift_held:
107+  86DC 3E 06                        ld      a, SHIFT_ROW
108+  86DE CD 91 86                     call    read_row
109+  86E1 E6 01                        and     SHIFT_BIT
110+  86E3 C9                           ret
111+  86E4
112+  86E4              ; What the key in A says with shift held, or nothing.
113+  86E4              ; Corrupts: AF, C, HL
114+  86E4              to_shifted:
115+  86E4 4F                           ld      c, a
116+  86E5 21 DA 87                     ld      hl, shifted_pairs
117+  86E8              .each:
118+  86E8 7E                           ld      a, (hl)
119+  86E9 B7                           or      a
120+  86EA 28 08                        jr      z, .none
121+  86EC B9                           cp      c
122+  86ED 23                           inc     hl
123+  86EE 7E                           ld      a, (hl)
124+  86EF 23                           inc     hl
125+  86F0 20 F6                        jr      nz, .each
126+  86F2 B7                           or      a
127+  86F3 C9                           ret
128+  86F4              .none:
129+  86F4 AF                           xor     a
130+  86F5 C9                           ret
131+  86F6
132+  86F6              ; Wait for a key and give it back in A, having waited for the last one to be
133+  86F6              ; let go first.
134+  86F6              ; Corrupts: everything
135+  86F6              read_key:
136+  86F6              .wait_release:
137+  86F6 CD 9F 86                     call    scan_keyboard
138+  86F9 B7                           or      a
139+  86FA 20 FA                        jr      nz, .wait_release
140+  86FC              .wait_press:
141+  86FC CD 9F 86                     call    scan_keyboard
142+  86FF B7                           or      a
143+  8700 28 FA                        jr      z, .wait_press
144+  8702 C9                           ret
145+  8703
146+  8703              ; Wait for a key, or for HL fiftieths of a second, whichever comes first.
147+  8703              ;
148+  8703              ; What is already held when the wait starts does not count, or the enter that
149+  8703              ; ended the order would end the wait as well.
150+  8703              ; Corrupts: everything
151+  8703              wait_or_key:
152+  8703 0E 00                        ld      c, 0                    ; nothing let go yet
153+  8705              .each_frame:
154+  8705 7C                           ld      a, h
155+  8706 B5                           or      l
156+  8707 C8                           ret     z                       ; the time went
157+  8708 2B                           dec     hl
158+  8709 E5                           push    hl
159+  870A 06 1C                        ld      b, LOOKS_A_FRAME
160+  870C              .look:
161+  870C C5                           push    bc
162+  870D CD 9F 86                     call    scan_keyboard
163+  8710 C1                           pop     bc
164+  8711 B7                           or      a
165+  8712 20 04                        jr      nz, .something
166+  8714 0E 01                        ld      c, 1                    ; the keyboard came clear
167+  8716 18 04                        jr      .keep_looking
168+  8718              .something:
169+  8718 79                           ld      a, c
170+  8719 B7                           or      a
171+  871A 20 05                        jr      nz, .a_key
172+  871C              .keep_looking:
173+  871C 10 EE                        djnz    .look
174+  871E E1                           pop     hl
175+  871F 18 E4                        jr      .each_frame
176+  8721              .a_key:
177+  8721 E1                           pop     hl
178+  8722 C9                           ret
