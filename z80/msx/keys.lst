 38+  864C 3A 2E 85                     ld      a, (cursor_x)
 39+  864F 83                           add     a, e
 40+  8650 FE 21                        cp      SCREEN_COLS + 1
 41+  8652 38 0F                        jr      c, .fits
 42+  8654 3A 2E 85                     ld      a, (cursor_x)
 43+  8657 B7                           or      a
 44+  8658 28 09                        jr      z, .fits                ; no point breaking at column 0
 45+  865A E5                           push    hl
 46+  865B C5                           push    bc
 47+  865C D5                           push    de
