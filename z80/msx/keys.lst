 50+  8087 7E                           ld      a, (hl)                 ; how many sections
 51+  8088 32 D8 80                     ld      (db_sections), a
 52+  808B                              ; the resident block follows the directory
 53+  808B 6F                           ld      l, a
 54+  808C 26 00                        ld      h, 0
 55+  808E 44                           ld      b, h
