# file opened: test_keyboard.asm
  1   0000              ; MIT License, Copyright (c) 2025 Cronomantic
  2   0000              ;
  3   0000              ; A build that does nothing but look at the keyboard, so a test can hold a key
  4   0000              ; down and see what the scanning makes of it.
  5   0000              ;
  6   0000              ; last_seen holds whatever the last look found, and seen_count counts how many
  7   0000              ; times a key was seen arriving after the keyboard had come clear, which is
  8   0000              ; what a line of typing is made of.
  9   0000              ;
 10   0000              ; It takes the whole machine as the real one will, because the font it prints
 11   0000              ; with comes out of the database and the database goes under the BIOS.
 12   0000
 13   0000                              DEVICE  NOSLOT64K
 14   0000
 15   0000              PPI_SLOTS       equ $A8                 ; two bits a page: which slot it sees
 16   0000              STACK_AT        equ $EF00               ; clear of everything that travels
 17   0000              database        equ $0000
 18   0000
 19   0000                              ORG     $8000
 20   8000              start:
 21   8000 F3                           di
 22   8001 31 00 EF                     ld      sp, STACK_AT
 23   8004 CD 64 80                     call    take_the_machine
 24   8007 CD 89 86                     call    keyboard_init
 25   800A CD 84 80                     call    db_init
 26   800D CD DA 80                     call    config_init
 27   8010 CD BD 81                     call    text_init
 28   8013 CD A4 83                     call    screen_init
 29   8016 3E 01                        ld      a, 1
 30   8018 32 5E 80                     ld      (ready_flag), a
 31   801B AF                           xor     a
 32   801C 32 62 80                     ld      (was_clear), a
 33   801F              .look:
 34   801F 3E 02                        ld      a, 2                    ; the row A and B sit on
 35   8021 CD 91 86                     call    read_row
 36   8024 32 60 80                     ld      (raw_row), a
 37   8027 CD 9F 86                     call    scan_keyboard
 38   802A 32 61 80                     ld      (scan_result), a
 39   802D B7                           or      a
 40   802E 28 13                        jr      z, .nothing
 41   8030 32 5F 80                     ld      (last_seen), a
 42   8033 3A 62 80                     ld      a, (was_clear)
 43   8036 B7                           or      a
 44   8037 28 E6                        jr      z, .look                ; still the same press
 45   8039 21 63 80                     ld      hl, seen_count
 46   803C 34                           inc     (hl)
 47   803D AF                           xor     a
 48   803E 32 62 80                     ld      (was_clear), a
 49   8041 18 DC                        jr      .look
 50   8043              .nothing:
 51   8043 3E 01                        ld      a, 1                    ; the keyboard came clear
 52   8045 32 62 80                     ld      (was_clear), a
 53   8048 18 D5                        jr      .look
