236+  877E              ; The eleven rows of eight, in the order the bits come out of each byte, as
237+  877E              ; they were measured key by key.  Letters come back in upper case because the
238+  877E              ; vocabulary is stored that way; a nought is a key with nothing to say here --
239+  877E              ; a shift, a cursor, a function key.
240+  877E              key_table:
241+  877E 30 31 32 33                  db      '0', '1', '2', '3', '4', '5', '6', '7'
241+  8782 34 35 36 37
242+  8786 38 39 2D 5E                  db      '8', '9', '-', '^', '\', '[', ']', ';'
242+  878A 5C 5B 5D 3B
243+  878E 27 60 2C 2E                  db      39, '`', ',', '.', '/', '_', 'A', 'B'
243+  8792 2F 5F 41 42
244+  8796 43 44 45 46                  db      'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J'
244+  879A 47 48 49 4A
