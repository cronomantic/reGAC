  2+  8634              ;
  3+  8634              ; Printing a run of text, breaking it between words.
  4+  8634              ;
  5+  8634              ; This knows nothing about any screen beyond how wide it is and where the
  6+  8634              ; cursor sits, both of which the machine's own screen layer names, so every
  7+  8634              ; machine shares it.
  8+  8634
  9+  8634              ; Print BC characters from HL, breaking between words so none is split.
 10+  8634              ; Corrupts: AF, BC, DE, HL
 11+  8634              print_text:
 12+  8634              .word:
 13+  8634 78                           ld      a, b
 14+  8635 B1                           or      c
 15+  8636 C8                           ret     z
 16+  8637                              ; how long is the run up to the next space
 17+  8637 E5                           push    hl
 18+  8638 C5                           push    bc
 19+  8639 11 00 00                     ld      de, 0                   ; E counts it
 20+  863C              .measure:
 21+  863C 78                           ld      a, b
 22+  863D B1                           or      c
 23+  863E 28 0E                        jr      z, .measured
