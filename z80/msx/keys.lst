236+  8782              ; The eleven rows of eight, in the order the bits come out of each byte, as
237+  8782              ; they were measured key by key.  Letters come back in upper case because the
238+  8782              ; vocabulary is stored that way; a nought is a key with nothing to say here --
239+  8782              ; a shift, a cursor, a function key.
240+  8782              key_table:
241+  8782 30 31 32 33                  db      '0', '1', '2', '3', '4', '5', '6', '7'
241+  8786 34 35 36 37
242+  878A 38 39 2D 5E                  db      '8', '9', '-', '^', '\', '[', ']', ';'
242+  878E 5C 5B 5D 3B
243+  8792 27 60 2C 2E                  db      39, '`', ',', '.', '/', '_', 'A', 'B'
243+  8796 2F 5F 41 42
244+  879A 43 44 45 46                  db      'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J'
244+  879E 47 48 49 4A
245+  87A2 4B 4C 4D 4E                  db      'K', 'L', 'M', 'N', 'O', 'P', 'Q', 'R'
245+  87A6 4F 50 51 52
246+  87AA 53 54 55 56                  db      'S', 'T', 'U', 'V', 'W', 'X', 'Y', 'Z'
246+  87AE 57 58 59 5A
247+  87B2 00 00 00 00                  db      0, 0, 0, 0, 0, 0, 0, 0          ; shift, control, the rest
247+  87B6 00 00 00 00
248+  87BA 00 00 00 00                  db      0, 0, 0, 0, 0, KEY_DELETE, 0, KEY_ENTER
248+  87BE 00 08 00 0D
249+  87C2 20 00 00 00                  db      ' ', 0, 0, 0, 0, 0, 0, 0
249+  87C6 00 00 00 00
250+  87CA 00 00 00 00                  db      0, 0, 0, 0, 0, 0, 0, 0          ; the number pad
250+  87CE 00 00 00 00
251+  87D2 00 00 00 00                  db      0, 0, 0, 0, 0, 0, 0, 0
251+  87D6 00 00 00 00
