245+  87A2 4F 50 51 52
246+  87A6 53 54 55 56                  db      'S', 'T', 'U', 'V', 'W', 'X', 'Y', 'Z'
246+  87AA 57 58 59 5A
247+  87AE 00 00 00 00                  db      0, 0, 0, 0, 0, 0, 0, 0          ; shift, control, the rest
247+  87B2 00 00 00 00
248+  87B6 00 00 00 00                  db      0, 0, 0, 0, 0, KEY_DELETE, 0, KEY_ENTER
248+  87BA 00 08 00 0D
249+  87BE 20 00 00 00                  db      ' ', 0, 0, 0, 0, 0, 0, 0
249+  87C2 00 00 00 00
250+  87C6 00 00 00 00                  db      0, 0, 0, 0, 0, 0, 0, 0          ; the number pad
250+  87CA 00 00 00 00
251+  87CE 00 00 00 00                  db      0, 0, 0, 0, 0, 0, 0, 0
251+  87D2 00 00 00 00
