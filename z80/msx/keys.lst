  1+  8685              ; MIT License, Copyright (c) 2025 Cronomantic
  2+  8685              ;
  3+  8685              ; Reading the keyboard on an MSX1, which hangs off the same 8255 the Amstrad's
  4+  8685              ; does: the row wanted goes in the low four bits of port C and its eight keys
  5+  8685              ; come back on port B, with a bit low while its key is held.
  6+  8685              ;
  7+  8685              ; The BIOS has a routine for this and keeps the whole matrix in memory for
  8+  8685              ; anyone to read, at $FBE5 -- which is where the eleven rows below were
  9+  8685              ; measured, one key at a time.  None of that is any use once the interpreter
 10+  8685              ; takes the machine for itself: the BIOS is paged out and its interrupt is not
 11+  8685              ; running, so nothing is scanning any more.  So this scans.
 12+  8685              ;
 13+  8685              ; The top four bits of port C are the cassette motor, the tape output, the key
 14+  8685              ; click and the caps lamp, and none of them are ours to change; whatever the
 15+  8685              ; machine had in them when we arrived is what it keeps.
 16+  8685
 17+  8685              PPI_B           equ $A9                 ; the eight keys of the row chosen
 18+  8685              PPI_C           equ $AA                 ; and, in its low half, which row
 19+  8685
 20+  8685              KEY_ROWS        equ 11
 21+  8685              SHIFT_ROW       equ 6                   ; and the bit of it the shift is on
 22+  8685              SHIFT_BIT       equ %00000001
 23+  8685
 24+  8685              KEY_ENTER       equ 13
 25+  8685              KEY_DELETE      equ 8
 26+  8685              INPUT_MAX       equ 64                  ; as much of a line as is kept
 27+  8685
 28+  8685              ; A fiftieth of a second is about seventy thousand clock cycles here, and one
 29+  8685              ; look at the whole keyboard is about two thousand five hundred, so this many
 30+  8685              ; looks fill a frame.  Nothing turns on it being exact.
 31+  8685              LOOKS_A_FRAME   equ 28
 32+  8685
 33+  8685              ; Take note of what the machine has in the top half of port C, which is not
 34+  8685              ; ours to change.
 35+  8685              ; Corrupts: AF
 36+  8685              keyboard_init:
 37+  8685 DB AA                        in      a, (PPI_C)
 38+  8687 E6 F0                        and     %11110000
 39+  8689 32 9A 86                     ld      (ppi_top), a
 40+  868C C9                           ret
 41+  868D
 42+  868D              ; Read the eight keys of row A, into A.  A bit high means held.
 43+  868D              ; Corrupts: AF, C
 44+  868D              read_row:
 45+  868D E6 0F                        and     %00001111
 46+  868F 4F                           ld      c, a
 47+  8690 3A 9A 86                     ld      a, (ppi_top)
 48+  8693 B1                           or      c
 49+  8694 D3 AA                        out     (PPI_C), a
 50+  8696 DB A9                        in      a, (PPI_B)
 51+  8698 2F                           cpl                             ; now one means held
 52+  8699 C9                           ret
 53+  869A
 54+  869A 00           ppi_top:        db      0
 55+  869B
 56+  869B              ; Look once at the whole keyboard.  The character comes back in A, and zero
 57+  869B              ; with the zero flag set when nothing useful is held.
 58+  869B              ;
 59+  869B              ; The shifts are passed over rather than reported, or holding one would look
 60+  869B              ; like nothing being typed at all; what they do is decided afterwards.
 61+  869B              ; Corrupts: BC, DE, HL
 62+  869B              scan_keyboard:
 63+  869B AF                           xor     a
 64+  869C 32 DF 87                     ld      (key_found), a
 65+  869F 21 7E 87                     ld      hl, key_table
 66+  86A2 16 00                        ld      d, 0                    ; which row
 67+  86A4              .row:
 68+  86A4 D5                           push    de
 69+  86A5 7A                           ld      a, d
 70+  86A6 CD 8D 86                     call    read_row
 71+  86A9 D1                           pop     de
 72+  86AA 1E 08                        ld      e, 8
 73+  86AC              .key:
 74+  86AC 1F                           rra
 75+  86AD 30 09                        jr      nc, .next_key
 76+  86AF F5                           push    af
 77+  86B0 7E                           ld      a, (hl)
 78+  86B1 B7                           or      a
 79+  86B2 28 03                        jr      z, .a_shift             ; a shift on its own says nothing
 80+  86B4 32 DF 87                     ld      (key_found), a
 81+  86B7              .a_shift:
 82+  86B7 F1                           pop     af
 83+  86B8              .next_key:
 84+  86B8 23                           inc     hl
 85+  86B9 1D                           dec     e
 86+  86BA 20 F0                        jr      nz, .key
 87+  86BC 14                           inc     d
 88+  86BD 7A                           ld      a, d
 89+  86BE FE 0B                        cp      KEY_ROWS
 90+  86C0 20 E2                        jr      nz, .row
 91+  86C2 3A DF 87                     ld      a, (key_found)
 92+  86C5 B7                           or      a
 93+  86C6 C8                           ret     z
 94+  86C7 CD D8 86                     call    shift_held
 95+  86CA 3A DF 87                     ld      a, (key_found)
 96+  86CD C8                           ret     z                       ; plain, as it is printed
 97+  86CE CD E0 86                     call    to_shifted
 98+  86D1 B7                           or      a
 99+  86D2 C0                           ret     nz
100+  86D3 3A DF 87                     ld      a, (key_found)          ; shift says nothing about it
101+  86D6 B7                           or      a
102+  86D7 C9                           ret
103+  86D8
104+  86D8              ; Whether the shift is held; zero flag clear if it is.
105+  86D8              ; Corrupts: AF, C
106+  86D8              shift_held:
107+  86D8 3E 06                        ld      a, SHIFT_ROW
108+  86DA CD 8D 86                     call    read_row
109+  86DD E6 01                        and     SHIFT_BIT
110+  86DF C9                           ret
111+  86E0
112+  86E0              ; What the key in A says with shift held, or nothing.
113+  86E0              ; Corrupts: AF, C, HL
114+  86E0              to_shifted:
115+  86E0 4F                           ld      c, a
116+  86E1 21 D6 87                     ld      hl, shifted_pairs
117+  86E4              .each:
118+  86E4 7E                           ld      a, (hl)
119+  86E5 B7                           or      a
120+  86E6 28 08                        jr      z, .none
121+  86E8 B9                           cp      c
122+  86E9 23                           inc     hl
123+  86EA 7E                           ld      a, (hl)
124+  86EB 23                           inc     hl
125+  86EC 20 F6                        jr      nz, .each
126+  86EE B7                           or      a
127+  86EF C9                           ret
128+  86F0              .none:
129+  86F0 AF                           xor     a
130+  86F1 C9                           ret
131+  86F2
132+  86F2              ; Wait for a key and give it back in A, having waited for the last one to be
133+  86F2              ; let go first.
134+  86F2              ; Corrupts: everything
135+  86F2              read_key:
136+  86F2              .wait_release:
137+  86F2 CD 9B 86                     call    scan_keyboard
138+  86F5 B7                           or      a
139+  86F6 20 FA                        jr      nz, .wait_release
140+  86F8              .wait_press:
141+  86F8 CD 9B 86                     call    scan_keyboard
142+  86FB B7                           or      a
143+  86FC 28 FA                        jr      z, .wait_press
144+  86FE C9                           ret
145+  86FF
146+  86FF              ; Wait for a key, or for HL fiftieths of a second, whichever comes first.
147+  86FF              ;
148+  86FF              ; What is already held when the wait starts does not count, or the enter that
149+  86FF              ; ended the order would end the wait as well.
150+  86FF              ; Corrupts: everything
151+  86FF              wait_or_key:
152+  86FF 0E 00                        ld      c, 0                    ; nothing let go yet
153+  8701              .each_frame:
154+  8701 7C                           ld      a, h
155+  8702 B5                           or      l
156+  8703 C8                           ret     z                       ; the time went
157+  8704 2B                           dec     hl
158+  8705 E5                           push    hl
159+  8706 06 1C                        ld      b, LOOKS_A_FRAME
160+  8708              .look:
161+  8708 C5                           push    bc
162+  8709 CD 9B 86                     call    scan_keyboard
163+  870C C1                           pop     bc
164+  870D B7                           or      a
165+  870E 20 04                        jr      nz, .something
166+  8710 0E 01                        ld      c, 1                    ; the keyboard came clear
167+  8712 18 04                        jr      .keep_looking
168+  8714              .something:
169+  8714 79                           ld      a, c
170+  8715 B7                           or      a
171+  8716 20 05                        jr      nz, .a_key
172+  8718              .keep_looking:
173+  8718 10 EE                        djnz    .look
174+  871A E1                           pop     hl
175+  871B 18 E4                        jr      .each_frame
176+  871D              .a_key:
177+  871D E1                           pop     hl
178+  871E C9                           ret
179+  871F
180+  871F              ; Read a line into input_buffer, as this adventure's codes.  The length comes
181+  871F              ; back in BC.  What is typed is shown as it goes.
182+  871F              ; Corrupts: everything
183+  871F              read_line:
184+  871F 21 E3 87                     ld      hl, input_buffer
185+  8722 22 E0 87                     ld      (line_ptr), hl
186+  8725 AF                           xor     a
187+  8726 32 E2 87                     ld      (line_length), a
188+  8729              .next_key:
189+  8729 CD F2 86                     call    read_key
190+  872C FE 0D                        cp      KEY_ENTER
191+  872E 28 2C                        jr      z, .finished
192+  8730 FE 08                        cp      KEY_DELETE
193+  8732 28 12                        jr      z, .rub_out
194+  8734 FE 20                        cp      32
195+  8736 38 F1                        jr      c, .next_key            ; nothing else is worth having
196+  8738 47                           ld      b, a
197+  8739 3A E2 87                     ld      a, (line_length)
198+  873C FE 40                        cp      INPUT_MAX
199+  873E 30 E9                        jr      nc, .next_key           ; the line is full
200+  8740 78                           ld      a, b
201+  8741 CD 69 87                     call    store_key
202+  8744 18 E3                        jr      .next_key
203+  8746              .rub_out:
204+  8746 3A E2 87                     ld      a, (line_length)
205+  8749 B7                           or      a
206+  874A 28 DD                        jr      z, .next_key
207+  874C 3D                           dec     a
208+  874D 32 E2 87                     ld      (line_length), a
209+  8750 2A E0 87                     ld      hl, (line_ptr)
210+  8753 2B                           dec     hl
211+  8754 22 E0 87                     ld      (line_ptr), hl
212+  8757 CD 04 85                     call    backspace
213+  875A 18 CD                        jr      .next_key
214+  875C              .finished:
215+  875C CD AF 84                     call    new_line
216+  875F 3A E2 87                     ld      a, (line_length)
217+  8762 4F                           ld      c, a
218+  8763 06 00                        ld      b, 0
219+  8765 21 E3 87                     ld      hl, input_buffer
220+  8768 C9                           ret
