  1+  8084              ; MIT License, Copyright (c) 2025 Cronomantic
  2+  8084              ;
  3+  8084              ; Finding things in the binary database.  See doc/binario.md.
  4+  8084              ;
  5+  8084              ;   Header
  6+  8084              ;     0  magic "RGAC"
  7+  8084              ;     4  version
  8+  8084              ;     5  machine
  9+  8084              ;     6  page bits
 10+  8084              ;     7  music mode
 11+  8084              ;     8  music buffer size
 12+  8084              ;    10  number of banks
 13+  8084              ;    11  number of sections
 14+  8084              ;    12  directory, five bytes a section: bank, offset, size
 15+  8084              ;
 16+  8084              ; A section is either resident, meaning always reachable, or it lives in a
 17+  8084              ; bank, and then the bank has to be brought in before the section can be read.
 18+  8084              ; How to bring it in is the machine's business: it gives db_page and says at
 19+  8084              ; what address a bank appears, and a machine with no banks gives the pair that
 20+  8084              ; does nothing, which is at the end of this file.
 21+  8084
 22+  8084              SECTION_CONFIG      equ 0
 23+  8084              SECTION_VOCAB       equ 1
 24+  8084              SECTION_OBJECTS     equ 2
 25+  8084              SECTION_LOCATIONS   equ 3
 26+  8084              SECTION_CONDITIONS  equ 4
 27+  8084              SECTION_TEXT        equ 5
 28+  8084              SECTION_FONT        equ 6
 29+  8084              SECTION_GRAPHICS    equ 7
 30+  8084              SECTION_MUSIC       equ 8
 31+  8084
 32+  8084              NO_MESSAGE          equ $FF   ; no message carries that number
 33+  8084              NOT_BANKED          equ $FF   ; the bank of a section that is resident
 34+  8084
 35+  8084              ; Inside the config section
 36+  8084              CONFIG_DIGITS       equ 3     ; the codes of "0" to "9"
 37+  8084              CONFIG_ASCII        equ 13    ; ASCII 32 to 127 -> this adventure's codes
 38+  8084              CONFIG_PUNCTUATION  equ 109   ; how many, then the codes; the space comes first
 39+  8084
 40+  8084              NO_CHARACTER        equ $FF   ; the adventure has no such character
 41+  8084
 42+  8084              HEADER_SECTION_COUNT equ 11
 43+  8084              HEADER_DIRECTORY     equ 12
 44+  8084              DIRECTORY_ENTRY_SIZE equ 5
