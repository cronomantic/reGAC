 14+  8631 B1                           or      c
 15+  8632 C8                           ret     z
 16+  8633                              ; how long is the run up to the next space
 17+  8633 E5                           push    hl
 18+  8634 C5                           push    bc
 19+  8635 11 00 00                     ld      de, 0                   ; E counts it
 20+  8638              .measure:
 21+  8638 78                           ld      a, b
 22+  8639 B1                           or      c
 23+  863A 28 0E                        jr      z, .measured
 24+  863C 7E                           ld      a, (hl)
 25+  863D E5                           push    hl
 26+  863E 21 B1 81                     ld      hl, space_code
 27+  8641 BE                           cp      (hl)
