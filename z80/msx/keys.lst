222+  876D              ; Put the character in A into the line and show it.
223+  876D              ; Corrupts: everything
224+  876D              store_key:
225+  876D CD 31 81                     call    ascii_to_code
226+  8770 FE FF                        cp      NO_CHARACTER
227+  8772 C8                           ret     z                       ; not a character this one has
228+  8773 2A E4 87                     ld      hl, (line_ptr)
229+  8776 77                           ld      (hl), a
230+  8777 23                           inc     hl
231+  8778 22 E4 87                     ld      (line_ptr), hl
232+  877B 21 E6 87                     ld      hl, line_length
233+  877E 34                           inc     (hl)
234+  877F C3 C8 84                     jp      print_char
