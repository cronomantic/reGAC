222+  8769              ; Put the character in A into the line and show it.
223+  8769              ; Corrupts: everything
224+  8769              store_key:
225+  8769 CD 31 81                     call    ascii_to_code
226+  876C FE FF                        cp      NO_CHARACTER
227+  876E C8                           ret     z                       ; not a character this one has
228+  876F 2A E0 87                     ld      hl, (line_ptr)
229+  8772 77                           ld      (hl), a
230+  8773 23                           inc     hl
231+  8774 22 E0 87                     ld      (line_ptr), hl
232+  8777 21 E2 87                     ld      hl, line_length
233+  877A 34                           inc     (hl)
234+  877B C3 C4 84                     jp      print_char
