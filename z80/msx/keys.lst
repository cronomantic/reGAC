 38+  8650 3A 32 85                     ld      a, (cursor_x)
 39+  8653 83                           add     a, e
 40+  8654 FE 21                        cp      SCREEN_COLS + 1
 41+  8656 38 0F                        jr      c, .fits
 42+  8658 3A 32 85                     ld      a, (cursor_x)
 43+  865B B7                           or      a
 44+  865C 28 09                        jr      z, .fits                ; no point breaking at column 0
 45+  865E E5                           push    hl
